{
  "name": "psychis",
  "private": true,
  "version": "1.0.1",
  "main": "electron_main.cjs",
  "author": "terenty99",
  "type": "module",
  "description": "PSYCHIS — Interactive Spatial Knowledge & Research Canvas",
  "scripts": {
    "app": "electron electron_main.cjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:all": "npm run build && electron-builder -mw"
  },
  "build": {
    "appId": "com.terenty99.psychis",
    "productName": "PSYCHIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron_main.cjs",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PSYCHIS"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "sign": false,
      "writeUpdateInfo": false
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "katex": "^0.16.21",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
