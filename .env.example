# Optional personal frontend configuration. Blank means unconfigured.
# WARNING: VITE_* values are embedded in browser builds. Do not publish a build
# containing personal credentials. Prefer Settings for personal local use and
# backend/.env for server-side Groq/Tavily secrets.
VITE_GROQ_API_KEY=
VITE_TAVILY_API_KEY=
VITE_YOUTUBE_API_KEY=
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=
