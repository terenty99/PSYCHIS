#!/usr/bin/env bash
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$DIR"

export PATH="/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v node >/dev/null 2>&1; then
  osascript -e 'display alert "Node.js не найден" message "Для работы приложения требуется Node.js. Установите его с nodejs.org или выполните в Терминале: brew install node"'
  exit 1
fi

if [ ! -d "node_modules" ] || [ ! -x "node_modules/.bin/electron" ]; then
  osascript -e 'tell application "Terminal" to do script "cd \"'"$DIR"'\" && echo \"📦 Установка библиотек PSYCHIS... Подождите минуту...\" && npm install && npm run app"'
  exit 0
fi

if [ ! -d "dist" ]; then
  npm run build
fi

npm run app
